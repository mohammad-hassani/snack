# Docker Compose reads this file after you copy it to .env.
DEBUG=1
SECRET_KEY=replace-with-a-random-secret-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=snack
POSTGRES_USER=snack
POSTGRES_PASSWORD=local-development-change-me
# Production: DEBUG=0, a real SECRET_KEY, HTTPS host/origin, and SMTP credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Snack <noreply@example.com>
# Public origin used in invitation and password-reset links (Docker).
FRONTEND_URL=http://localhost:8000
